# Public production origin, without a trailing slash (for example, https://example.com).
# Until this is set, metadata uses localhost and robots block indexing.
NEXT_PUBLIC_SITE_URL=

# Set this in the AWS build environment as well as the running container because
# Next.js resolves canonical and social metadata during the production build.

# Sanity CMS. When omitted, the blog uses local seeded preview content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
